---
import Layout from "../components/Layout.astro";
---
<Layout title="404: Page Not Found" lang="en" description="The page you are looking for does not exist.">
  <div class="text-center py-20">
    <h1 class="text-5xl font-bold mb-4">404</h1>
    <p class="text-xl mb-8">Sorry, we couldn't find the page you're looking for.</p>
    <a href="/" class="bg-brand text-white px-6 py-2 rounded-lg">Return Home</a>
  </div>
</Layout>