---
import Layout from "../../components/Layout.astro";
import { getEntry } from "astro:content";
import GalleryClient from "../../components/GalleryClient.astro";

type Lang = "en" | "it" | "de";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "it" } },
    { params: { lang: "de" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

// Fetching images based on the language parameter
const gallery = await getEntry(`${lang}-properties`, "gallery"); 
const images = gallery.data;
---

<Layout lang={lang} title="Photo Gallery" description="Gallery">
  <section class="pt-20 pb-16 px-4 max-w-6xl mx-auto">
    
    {/* Decorative Label */}
    <div class="flex items-center gap-4 mb-4">
      <div class="h-px w-12 bg-amber-600"></div>
      <span class="text-sm font-bold uppercase tracking-[0.2em] text-amber-700">
        Photo Gallery
      </span>
    </div>
 
    <div class="mt-12">
      <GalleryClient images={images} />
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-family: 'Playfair Display', serif, system-ui;
  }
</style>