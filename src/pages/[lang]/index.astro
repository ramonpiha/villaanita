---
import { getEntry } from "astro:content";
import Layout from "../../components/Layout.astro";
import MapClient from "../../components/MapClient.js";
import AutoDetect from "../../components/AutoDetectLang.astro";
import Slider from "../../components/Slider.tsx";
import PropertyList from "../../components/PropertyList.astro";

type Lang = "en" | "it" | "de";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "it" } },
    { params: { lang: "de" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

// Get the home page content
const homeEntry = await getEntry(`${lang}-pages`, "home");

// Get properties data
const propertiesEntry = await getEntry(`${lang}-properties`, "properties"); 
// Fetch gallery data to populate the slider
const galleryEntry = await getEntry(`${lang}-properties`, "gallery"); // 

// Destructure title, heading, and subheading from the markdown frontmatter
const { title, heading, subheading } = homeEntry.data;
const { Content } = await homeEntry.render();
const properties = propertiesEntry.data;

/**
 * Transform the gallery YAML data into the format expected by Slider.tsx.
 * We map 'image' to 'src' and 'summary' to 'alt'.
 */
const sliderImages = galleryEntry.data.map((item: any) => ({
  src: item.image,
  alt: item.summary
}));
---

<Layout lang={lang} title={title} description={subheading}>
  <AutoDetect />

  <div class="pt-10 pb-6 px-4 max-w-4xl mx-auto">
    <h1
      class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight flex items-center gap-3"
    >
      <img src="/images/bnbLogo.avif" alt="Home" class="h-10 w-auto" />
      {heading}
    </h1>
    <p class="text-lg md:text-xl text-gray-600 leading-relaxed">
      {subheading}
    </p>
  </div>

  <div class="my-8">
    {/* Use client:load to ensure the React slider is interactive */}
    <Slider slides={sliderImages} client:load />
  </div>

  <div class="prose prose-lg max-w-none">
    <Content />
  </div>

  <div class="rounded-lg overflow-hidden shadow-lg my-8">
    <MapClient client:only="react" locations={properties} lang={lang} />
  </div>

  <PropertyList properties={properties} lang={lang} />
</Layout>