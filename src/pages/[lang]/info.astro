---
import { getEntry, render } from "astro:content";
import VideoList from "../../components/VideoList.astro";
import Layout from "../../components/Layout.astro";

type Lang = "en" | "it" | "de";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "it" } },
    { params: { lang: "de" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const homeEntry = await getEntry(`${lang}-pages`, "info");
if (!homeEntry) {
  throw new Error(`Info page content not found for ${lang}`);
}
const { title, heading, subheading } = homeEntry.data;
const { Content } = await render(homeEntry);
const videosEntry = await getEntry(`${lang}-check-in-videos`, "check-in-videos");
if (!videosEntry) {
  throw new Error(`Check-in video content not found for ${lang}`);
}
const videos = videosEntry.data;
---

<Layout lang={lang} title={title} description={subheading}>
  <div class="pt-10 pb-6 px-4 max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight flex items-center gap-3">
      <img src="/images/bnbLogo.avif" alt="Home" class="h-10 w-auto" />
      {heading}
    </h1>
    <p class="text-lg md:text-xl text-gray-600 leading-relaxed">
      {subheading}
    </p>
  </div>

  <hr class="border-gray-200 my-8 mx-4 max-w-4xl md:mx-auto" />

  <div class="prose prose-lg max-w-none mt-12">
    <Content />
  </div>
  <VideoList videos={videos} lang={lang} />
</Layout>
