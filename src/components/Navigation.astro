---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<header
  id="main-header"
  class="border-b border-[#e6ae48]/20 fixed top-0 z-50 w-full overflow-x-hidden"
  style="background-color: rgb(27, 36, 48); transition: transform 0.3s ease-in-out;"
>
  <nav
    class="w-full max-w-7xl mx-auto p-4 flex justify-between items-center gap-4"
  >
    <!-- Logo -->
    <a
      href={`/${lang}/`}
      class="text-xl font-bold font-serif text-brand flex items-center flex-shrink-0"
    >
      <img
        src="/images/bnbLogo.avif"
        alt="Villa Anita Bolzano Rooms"
        class="h-20 w-auto"
        loading="lazy"
      />
    </a>

    <!-- Desktop Menu -->
    <div class="hidden lg:flex items-center gap-6 flex-1 justify-center">
      <a href={`/${lang}/`} class="desktop-menu-item">Home</a>
      <a href={`/${lang}/info`} class="desktop-menu-item">Info</a>
      <a href={`/${lang}/services`} class="desktop-menu-item">Services</a>
      <a href={`/${lang}/activities`} class="desktop-menu-item">Activities</a>
      <a href={`/${lang}/contacts`} class="desktop-menu-item">Contacts</a>
      <a href={`/${lang}/gallery`} class="desktop-menu-item">Gallery</a>
    </div>

    <!-- Right Side -->
    <div class="flex items-center gap-4 flex-shrink-0">
      <!-- Language Switcher (Desktop) -->
      <div class="hidden lg:block">
        <LanguageSwitcher />
      </div>

      <!-- Hamburger -->
      <button
        class="lg:hidden hover:text-[#e6ae48]/80 transition-colors p-2 relative w-10 h-10 flex items-center justify-center"
        id="mobile-menu-toggle"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        style="color: #e6ae48;"
      >
        <div class="hamburger-icon">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu-links"
    class="mobile-menu lg:hidden"
    style="background-color: rgb(27, 36, 48);"
  >
    <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col gap-1">
      <a href={`/${lang}/`} class="mobile-menu-item">Home</a>
      <a href={`/${lang}/info`} class="mobile-menu-item">Info</a>
      <a href={`/${lang}/services`} class="mobile-menu-item">Services</a>
      <a href={`/${lang}/activities`} class="mobile-menu-item">Activities</a>
      <a href={`/${lang}/gallery`} class="mobile-menu-item">Gallery</a>
      <a href={`/${lang}/contacts`} class="mobile-menu-item">Contacts</a>

      <div class="mt-4 pt-4 border-t border-brand/10 w-full">
        <LanguageSwitcher />
      </div>
    </div>
  </div>
</header>



<style>
  /* Hamburger Icon */
  .hamburger-icon {
    width: 24px;
    height: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-icon span {
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .menu-open .hamburger-icon span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-open .hamburger-icon span:nth-child(2) {
    opacity: 0;
  }

  .menu-open .hamburger-icon span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Desktop Menu */
  .desktop-menu-item {
    color: #e6ae48;
    font-weight: 500;
    font-size: 1.125rem;
    text-transform: uppercase;
    padding: 0.625rem 1rem;
    border-radius: 0.5rem;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .desktop-menu-item:hover {
    color: #f0c066;
    background-color: rgba(230, 174, 72, 0.1);
  }

  /* Mobile Menu */
  .mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .mobile-menu.menu-open {
    max-height: 500px;
  }

  .mobile-menu-item {
    padding: 0.875rem 1rem;
    color: #e6ae48;
    font-size: 1.125rem;
    border-radius: 0.5rem;
  }

  .mobile-menu-item:hover {
    background-color: rgba(230, 174, 72, 0.1);
  }
</style>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu-links");
  const header = document.getElementById("main-header");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("menu-open");
      toggle.classList.toggle("menu-open");
    });

    document.addEventListener("click", (e) => {
      if (!(e.target instanceof Node)) return;

      if (!toggle.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.remove("menu-open");
        toggle.classList.remove("menu-open");
      }
    });
  }

  // Scroll detection for header show/hide
  if (header) {
    let lastScrollY = window.scrollY;
    let isScrolling = false;

    const handleScroll = () => {
      const currentScrollY = window.scrollY;

      // Always show header at the very top
      if (currentScrollY <= 10) {
        header.style.transform = 'translateY(0)';
      }
      // Scrolling down - hide header (only after scrolling past 300px)
      else if (currentScrollY > lastScrollY && currentScrollY > 300) {
        header.style.transform = 'translateY(-100%)';
      }
      // Scrolling up - show header
      else if (currentScrollY < lastScrollY) {
        header.style.transform = 'translateY(0)';
      }

      lastScrollY = currentScrollY;
      isScrolling = false;
    };

    window.addEventListener('scroll', () => {
      if (!isScrolling) {
        window.requestAnimationFrame(handleScroll);
        isScrolling = true;
      }
    }, { passive: true });
  }
</script>