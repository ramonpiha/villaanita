---
import Navigation from "./Navigation.astro";
import FloatingBookButton from "./FloatingBookButton.astro";
import Footer from "./Footer.astro";
const { lang, title } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Lora:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-bg text-brand font-sans antialiased">
    <Navigation lang={lang} />

    <main class="max-w-5xl mx-auto p-4 sm:p-6 lg:p-8" style="padding-top: 140px;">
      <slot />
    </main>

    <Footer lang={lang} />

    <FloatingBookButton lang={lang} />
  </body>
</html>