---
// src/components/PropertyList.astro
interface Property {
  id: string;
  type: string[];
  title: string;
  summary: string;
  coordinates: [number, number];
  images: string[];
}

interface Props {
  properties: Property[];
  lang: 'de' | 'it' | 'en';
}

const { properties, lang } = Astro.props;

// 1. Define the ID of the property you want to be "Big"
const featuredId = "villa-anita-map";

// 2. Separate the properties
const featuredProperty = properties.find((p) => p.id === featuredId);

const gridProperties = properties.filter(
  (p) => p.id !== featuredId && p.type && p.type.includes("map")
);

// Helper function to build the URL based on your logic
const getPropertyLink = (id: string) => {
  // If you use standard dynamic routing like /[lang]/properties/[id]
  return `/${lang}/properties/${id}`;
};
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <h2 class="text-3xl font-bold text-gray-900 mb-6">
    {lang === 'de' ? 'Unsere Standorte' : lang === 'it' ? 'Le nostre sedi' : 'Our Locations'}
  </h2>

  {featuredProperty && (
    <div class="mb-8">
      <a
        href={getPropertyLink(featuredProperty.id)}
        class="block group relative h-96 md:h-[500px] w-full rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition duration-300 ease-in-out"
      >
        <img
          src={featuredProperty.images[0]}
          alt={featuredProperty.title}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-8">
          <h3 class="text-3xl md:text-4xl font-bold text-white mb-2">
            {featuredProperty.title}
          </h3>
          <p class="text-gray-200 text-lg md:text-xl max-w-2xl">
            {featuredProperty.summary}
          </p>
        </div>
      </a>
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {gridProperties.map((property) => (
      <a
        href={getPropertyLink(property.id)}
        class="block group relative h-72 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition duration-300 transform hover:-translate-y-1"
      >
        <img
          src={property.images[0]}
          alt={property.title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        
        <div class="absolute bottom-0 left-0 right-0 bg-black/70 backdrop-blur-sm p-4 transition-colors group-hover:bg-black/80">
          <h3 class="text-xl font-bold text-white">
            {property.title}
          </h3>
          <p class="text-sm text-gray-300 truncate">
            {property.summary}
          </p>
        </div>
      </a>
    ))}
  </div>
</div>