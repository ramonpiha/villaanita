---
interface GalleryImage {
  id: string;
  type: string[];
  title: string;
  summary: string;
  image: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 p-4">
  {
    images.map((img: GalleryImage) => (
      <div
        class="group relative cursor-pointer overflow-hidden rounded-lg shadow-md"
        data-gallery-item={img.image}
      >
        <img
          src={img.image}
          alt={img.title}
          loading="lazy"
          class="aspect-[4/5] w-full object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
        />
      </div>
    ))
  }
</div>

<div
  id="lightbox"
  class="fixed inset-0 bg-white/70 backdrop-blur-sm flex justify-center items-center z-50 hidden opacity-0 transition-opacity duration-300 cursor-zoom-out"
>
  <div class="relative max-w-[95vw] max-h-[95vh]">
    <img
      id="lightbox-img"
      src=""
      class="max-h-[90vh] max-w-full rounded-sm shadow-2xl object-contain"
    />
  </div>
  <button
    id="close-button"
    class="fixed top-6 right-6 text-gray-800 hover:text-gray-600 transition-colors duration-200 z-51"
    aria-label="Close image"
  >
    <svg
      class="w-8 h-8"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"
      ></path>
    </svg>
  </button>
</div>

<script>
  const items = document.querySelectorAll("[data-gallery-item]");
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById(
    "lightbox-img"
  ) as HTMLImageElement;
  const closeButton = document.getElementById("close-button");

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.remove("opacity-100");
      setTimeout(() => {
        if (lightbox) lightbox.classList.add("hidden");
        if (lightboxImg) lightboxImg.src = "";
      }, 300);
    }
  }

  items.forEach((item) => {
    item.addEventListener("click", () => {
      const src = item.getAttribute("data-gallery-item");

      if (src && lightbox && lightboxImg) {
        lightboxImg.src = src;
        lightbox.classList.remove("hidden");
        setTimeout(() => lightbox.classList.add("opacity-100"), 10);
      }
    });
  });

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  closeButton?.addEventListener("click", (e) => {
    e.stopPropagation();
    closeLightbox();
  });
</script>
